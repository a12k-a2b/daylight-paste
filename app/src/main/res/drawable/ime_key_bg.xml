<?xml version="1.0" encoding="utf-8"?>
<!-- LivePaper key: white key face, 1dp ruled border, no shadow. Pressed = cream. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetLeft="3dp" android:insetRight="3dp" android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="#EAE5DC" />
                <stroke android:width="1.5dp" android:color="#111111" />
                <corners android:radius="6dp" />
            </shape>
        </inset>
    </item>
    <item android:state_checkable="true" android:state_checked="true">
        <inset android:insetLeft="3dp" android:insetRight="3dp" android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="#FDE7C6" />
                <stroke android:width="1.5dp" android:color="#C87D20" />
                <corners android:radius="6dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="3dp" android:insetRight="3dp" android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="#FFFFFF" />
                <stroke android:width="1dp" android:color="#CDC6B8" />
                <corners android:radius="6dp" />
            </shape>
        </inset>
    </item>
</selector>
